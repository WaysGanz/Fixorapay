# Salin menjadi .env. JANGAN commit .env asli.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://fixora:fixora@localhost:5432/fixora_pay?schema=public

# 64 karakter hex (32 byte). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dipakai mengenkripsi secret API key merchant di database. Wajib di production.
APP_ENCRYPTION_KEY=

# 'mock' hanya untuk development/test. Production MENOLAK mock.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=ganti-untuk-dev

# Batas & timing
MIN_PAYMENT_AMOUNT=1000
MAX_PAYMENT_AMOUNT=50000000
PAYMENT_EXPIRY_MINUTES=30
EXPIRY_GRACE_SECONDS=300
PROVIDER_TIMEOUT_MS=10000
MAX_PROVIDER_CREATE_ATTEMPTS=3
SIGNATURE_TOLERANCE_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

# Server-to-server saja. Kosongkan = tanpa header CORS.
CORS_ORIGINS=
